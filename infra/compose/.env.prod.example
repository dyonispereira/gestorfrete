# Production Readiness Hardening, Parte 6 — template para infra/compose/docker-compose.prod.yml.
#
# Copie para `.env.prod` (NUNCA commitado — já coberto por .gitignore como todo `.env*` que não
# termine em `.example`) e preencha cada valor com um segredo real, gerado para este deploy
# especificamente. Nenhum destes pode ser o valor de desenvolvimento visto em .env.example.
#
# O compose falha explicitamente (antes de qualquer container subir) se qualquer uma destas
# variáveis estiver ausente — não há default aqui, de propósito.

# --- PostgreSQL ---
POSTGRES_USER=gestorfrete_prod
POSTGRES_PASSWORD=GERE_UMA_SENHA_FORTE_REAL_AQUI
POSTGRES_DB=gestorfrete

# --- MinIO ---
MINIO_ROOT_USER=gestorfrete_prod
MINIO_ROOT_PASSWORD=GERE_UM_SEGREDO_FORTE_REAL_AQUI

# --- API ---
# Nunca "change-me" — o próprio processo recusa iniciar se detectar isso (Parte 1).
JWT_SECRET_KEY=GERE_UM_SEGREDO_FORTE_REAL_AQUI
# Lista JSON com a origem real do frontend do piloto — nunca só localhost em produção.
CORS_ORIGINS=["https://app.SEU_DOMINIO_AQUI"]

# --- Web ---
# URL pública que o NAVEGADOR do usuário vai chamar — nunca o nome DNS interno do Docker.
NEXT_PUBLIC_API_URL=https://api.SEU_DOMINIO_AQUI

# --- Caddy / TLS ---
DOMAIN=SEU_DOMINIO_AQUI
CADDY_ACME_EMAIL=seu-email-de-operacao@SEU_DOMINIO_AQUI
